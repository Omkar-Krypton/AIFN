{
  "name": "api-interceptor-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:obfuscate": "npm run build && npm run obfuscate",
    "build:extension": "node scripts/build.js && node scripts/obfuscate.js && node scripts/randomize-build.cjs && node scripts/fix-missing-imports.cjs",
    "build:extension:no-obf": "node scripts/build.js --no-obfuscate && node scripts/randomize-build.cjs && node scripts/fix-missing-imports.cjs",
    "obfuscate": "node scripts/obfuscate.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "lucide-react": "^0.526.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.7.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "javascript-obfuscator": "^4.2.2",
    "terser": "^5.46.0",
    "vite": "^7.2.4"
  }
}
