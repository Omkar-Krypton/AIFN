{
  "manifest_version": 3,
  "name": "Team Collaboration Extension DEV AI",
  "version": "2.0.0",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "cookies",
    "scripting",
    "browsingData",
    "notifications",
    "system.cpu",
    "management"
  ],
 "host_permissions": [
  "*://naukri.com/*",
  "*://*.naukri.com/*",
  "*://naukrigulf.com/*",
  "*://*.naukrigulf.com/*",
  "*://shine.com/*",
  "*://*.shine.com/*"
],
  "content_scripts": [
    {
      "matches": ["https://*.naukri.com/*"],
      "js": ["js/inject_naukri.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://resdex.naukri.com/*",
        "*://*.resdex.naukri.com/*"
      ],
      "js": ["content/utils/contentScript.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.shine.com/*",
        "*://shine.com/*",
        "*://recruiter.shine.com/*",
        "*://*.recruiter.shine.com/*"
      ],
      "js": [
        "content/utils/messaging.js",
        "content/utils/dom.js",
        "content/utils/contentScript.js",
        "content/sjb/support.js",
        "content/sjb/converter.js",
        "content/sjb/tools.js",
        "content/sjb/extractor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["nexusPage.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "matrixDaemon.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  }
}
